    "After" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de"
          }
        }
      }
    },
    "Allow the camera for CloudWanderer in Settings, or enter the drive's details by hand." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que CloudWanderer use la cámara en Ajustes, o introduzca los datos de la unidad a mano."
          }
        }
      }
    },
    "Apache 2 licensed software" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Software con licencia Apache 2"
          }
        }
      }
    },
    "Attention: other apps saved changes into these drives. The drives are read-only, so the changes exist only on this iPhone, and uninstalling deletes them. Copy them somewhere else in Files first to keep them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atención: otras apps han guardado cambios en estas unidades. Las unidades son de solo lectura, así que los cambios solo existen en este iPhone y al desinstalar se eliminan. Cópielos antes en otro lugar de Archivos para conservarlos."
          }
        }
      }
    },
    "Attention: this file and its password open every drive in it. Send the password separately, never with the file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atención: este archivo y su contraseña abren todas las unidades que contiene. Envíe la contraseña por separado, nunca junto al archivo."
          }
        }
      }
    },
    "Attention: without its password, an encrypted drive can't be read. Export your drives first if you'll need them again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atención: sin su contraseña, una unidad cifrada no se puede leer. Exporte antes sus unidades si va a volver a necesitarlas."
          }
        }
      }
    },
    "Back" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrás"
          }
        }
      }
    },
    "Browse your own WebDAV and SFTP servers, and download and export files from them. Nothing is sent anywhere else." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore sus propios servidores WebDAV y SFTP, y descargue y exporte archivos de ellos. No se envía nada a ningún otro sitio."
          }
        }
      }
    },
