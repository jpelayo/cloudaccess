<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CloudCore's sentences whose words change with a number. es.lproj has the same keys. -->
<plist version="1.0">
<dict>
	<!-- RemoteError.swift, FileProblem: the sync store's prefix on a failure it stops retrying. -->
	<key>Stopped trying after %lld failures.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@failures@</string>
		<key>failures</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Stopped trying after %lld failure.</string>
			<key>other</key>
			<string>Stopped trying after %lld failures.</string>
		</dict>
	</dict>
	<!-- DrivesFile.swift -->
	<key>The password needs at least %lld characters.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@characters@</string>
		<key>characters</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>The password needs at least %lld character.</string>
			<key>other</key>
			<string>The password needs at least %lld characters.</string>
		</dict>
	</dict>
	<!-- Uninstall.swift -->
	<key>Found %lld drives.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@drives@</string>
		<key>drives</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Found %lld drive.</string>
			<key>other</key>
			<string>Found %lld drives.</string>
		</dict>
	</dict>
	<key>Waiting for %lld files to upload.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Waiting for %lld file to upload.</string>
			<key>other</key>
			<string>Waiting for %lld files to upload.</string>
		</dict>
	</dict>
	<key>Deleted %lld items.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Deleted %lld item.</string>
			<key>other</key>
			<string>Deleted %lld items.</string>
		</dict>
	</dict>
	<key>Deleted %lld passwords.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@passwords@</string>
		<key>passwords</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Deleted %lld password.</string>
			<key>other</key>
			<string>Deleted %lld passwords.</string>
		</dict>
	</dict>
</dict>
</plist>
