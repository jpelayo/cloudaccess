<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Starts CloudMount at login and brings it back if it crashes or macOS ends it under
	     memory pressure, because remote changes only reach Finder while it runs. Quit exits
	     with 0, which launchd leaves alone. Registered through SMAppService.agent(plistName:).
	     CLOUDMOUNT_AGENT tells the running copy it's the agent's. -->
	<key>Label</key>
	<string>com.infinitecontext.CloudMount.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/CloudMount</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CLOUDMOUNT_AGENT</key>
		<string>1</string>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.infinitecontext.CloudMount</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
