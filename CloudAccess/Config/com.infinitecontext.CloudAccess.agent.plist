<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Starts CloudAccess at login and brings it back if it crashes or macOS ends it under
	     memory pressure, because remote changes only reach Finder while it runs. Quit exits
	     with 0, which launchd leaves alone. Registered through SMAppService.agent(plistName:).
	     CLOUDACCESS_AGENT tells the running copy it's the agent's. -->
	<key>Label</key>
	<string>com.infinitecontext.CloudAccess.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/CloudAccess</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CLOUDACCESS_AGENT</key>
		<string>1</string>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.infinitecontext.CloudAccess</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
