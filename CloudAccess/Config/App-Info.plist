<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The drives file, so Import… can choose it and AirDrop names it. The Mac doesn't open it
	from Finder: the launch agent's single-copy check can drop that event. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.infinitecontext.cloudaccess.drives</string>
			<key>UTTypeDescription</key>
			<string>CloudAccess Drives</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cadrives</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
