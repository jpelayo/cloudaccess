{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "es",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "../Packages/CloudCore",
    },
  ],
  "files": [
    { "kind": "folder", "path": "CloudAccess", "target-membership": [ "CloudAccess" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/CloudAccess.app", "id": "3EF20536309CA13400F19401", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/CloudAccessFileProvider.appex", "id": "3EC63C03309CB198005672C7", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "CloudAccess/copy/Embed Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
    { "kind": "folder", "path": "CloudAccessFileProvider", "target-membership": [ "CloudAccessFileProvider" ] },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "com.infinitecontext.CloudAccess.agent.plist", "target-membership": [ "CloudAccess/copy/Copy Launch Agent" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "CloudAccess",
      "id": "3EF20535309CA13400F19401",
      "product": "Products/CloudAccess.app",
      "product-type": "application",
      "dependencies": [
        "CloudAccessFileProvider",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Copy Launch Agent",
          "bundle-base-path": "contents-directory",
          "relative-path": "Library/LaunchAgents",
        },
      ],
      "package-product-members": [
        {
          "package": "CloudCore",
          "product-name": "CloudCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "CloudCore",
          "product-name": "CloudDesign",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "CloudCore",
          "product-name": "RemoteEngine",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "CloudCore",
          "product-name": "SyncCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
