    "Another drive already uses this folder on this server." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra unidad ya usa esta carpeta en este servidor."
          }
        }
      }
    },
    "Anything deleted more than %@ ago is removed from the server for good, on every device using this drive. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo eliminado hace más de %@ se quita del servidor para siempre, en todos los dispositivos que usan esta unidad. Esto no se puede deshacer."
          }
        }
      }
    },
