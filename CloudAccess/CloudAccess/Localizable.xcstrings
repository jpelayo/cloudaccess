        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estado"
          }
        }
      }
    },
    "Stop After This Drive" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener tras esta unidad"
          }
        }
      }
    },
    "Stop Uninstalling" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejar de desinstalar"
          }
        }
      }
    },
    "Stop writing to this drive for good" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejar de escribir en esta unidad para siempre"
          }
        }
      }
    },
    "Stopped until you press Try Again" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido hasta que pulse Reintentar"
          }
        }
      }
    },
    "Stopped. The drives not yet removed are still on this Mac and working." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido. Las unidades que aún no se han quitado siguen en este Mac y funcionan."
          }
        }
      }
    },
    "Syncing" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizando"
          }
        }
      }
    },
    "System follows your Mac's language" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema usa el idioma de su Mac"
          }
        }
      }
    },
    "Tailscale is off on this Mac, and this drive may need it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale está desactivado en este Mac, y puede que esta unidad lo necesite."
          }
        }
      }
    },
    "Take this drive off this Mac" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar esta unidad de este Mac"
          }
        }
      }
    },
    "That folder couldn't be made: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido crear esa carpeta: %@"
          }
        }
      }
    },
    "That key can't be read: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer esa clave: %@"
          }
        }
      }
    },
    "That name can't be used for a folder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese nombre no se puede usar para una carpeta."
          }
        }
      }
    },
    "The drive is removed and added again. Files that haven't uploaded are kept, and Settings shows where." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La unidad se quita y se vuelve a añadir. Los archivos que no se han subido se conservan, y Ajustes muestra dónde."
          }
        }
      }
    },
    "The encrypted drive can't be opened" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La unidad cifrada no se puede abrir"
          }
        }
      }
    },
    "The encryption marker stays, because the drive can't be opened without it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La marca de cifrado se queda, porque la unidad no se puede abrir sin ella."
          }
        }
      }
    },
    "The encryption password isn't right" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de cifrado no es correcta"
          }
        }
      }
    },
    "The encryption password saved on this Mac can't read the files on the server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la contraseña de cifrado guardada en este Mac no se pueden leer los archivos del servidor."
          }
        }
      }
    },
    "The file's password" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña del archivo"
          }
        }
      }
    },
    "The files stay on this Mac, but CloudAccess stops showing where they are." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos se quedan en este Mac, pero CloudAccess deja de mostrar dónde están."
          }
        }
      }
    },
    "The new language shows after a restart" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo idioma se verá tras reiniciar"
          }
        }
      }
    },
    "The QR code couldn't be drawn. In CloudWanderer, add the drive with Enter Details by Hand instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido dibujar el código QR. En CloudWanderer, añada la unidad con Introducir los datos a mano."
          }
        }
      }
    },
    "The saved drives can't be read: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden leer las unidades guardadas: %@"
          }
        }
      }
    },
    "The server refused to open this folder" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor se ha negado a abrir esta carpeta"
          }
        }
      }
    },
    "The server refused to open this folder. Check that this user can read it. On a Mac server, Documents, Desktop and Downloads also need \"Allow full disk access for remote users\", under System Settings, General, Sharing, Remote Login." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor se ha negado a abrir esta carpeta. Compruebe que este usuario puede leerla. En un servidor Mac, Documentos, Escritorio y Descargas también necesitan “Permitir acceso total al disco para usuarios remotos”, en Ajustes del Sistema, General, Compartir, Sesión remota."
          }
        }
      }
    },
    "The server refuses the sign-in" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechaza el inicio de sesión"
          }
        }
      }
    },
    "The server, folder or account is different, so the drive is set up again from what's there. Nothing is deleted on either server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor, la carpeta o la cuenta son distintos, así que la unidad se vuelve a configurar con lo que hay allí. No se elimina nada en ninguno de los servidores."
          }
        }
      }
    },
    "The server's identity has changed" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La identidad del servidor ha cambiado"
          }
        }
      }
    },
    "The user name or password is no longer valid." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario o la contraseña ya no son válidos."
          }
        }
      }
    },
    "These drives will be removed from Finder, and their passwords deleted from this Mac. Files on your servers are not changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas unidades se quitarán del Finder y sus contraseñas se eliminarán de este Mac. Los archivos de sus servidores no cambian."
          }
        }
      }
    },
    "These files are on this Mac and haven't reached the server. CloudAccess won't send them until you press Try Again, or rename them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos archivos están en este Mac y no han llegado al servidor. CloudAccess no los enviará hasta que pulse Reintentar o les cambie el nombre."
          }
        }
      }
    },
    "These files keep failing. macOS tries them again by itself, and after 15 minutes of failures CloudAccess stops trying and waits for you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos archivos siguen fallando. macOS vuelve a intentarlo por sí solo, y tras 15 minutos de fallos CloudAccess deja de intentarlo y espera a que usted actúe."
          }
        }
      }
    },
    "These folders and everything in them stay on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas carpetas y todo lo que contienen se quedan en este Mac."
          }
        }
      }
    },
    "They're removed from the server now, for every device using this drive. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan del servidor ahora, para todos los dispositivos que usan esta unidad. No se puede deshacer."
          }
        }
      }
    },
    "Third-party software" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Software de terceros"
          }
        }
      }
    },
    "This address has a different server. Save again to use it instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esta dirección hay otro servidor. Guarde de nuevo para usarlo en su lugar."
          }
        }
      }
    },
    "This can't be changed later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no se puede cambiar después."
          }
        }
      }
    },
    "This can't be changed later. A lost password can't be recovered, and neither can the files. Save a recovery kit from the drive's details afterwards." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no se puede cambiar después. Una contraseña perdida no se puede recuperar, y los archivos tampoco. Después, guarde un kit de recuperación desde los detalles de la unidad."
          }
        }
      }
    },
    "This drive is in Unsafe mode, so what's deleted now is gone for good. Files deleted before stay listed here, and can be restored in Safe mode." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta unidad está en modo Inseguro, así que lo que se elimine ahora desaparece para siempre. Los archivos eliminados antes siguen en esta lista, y se pueden restaurar en modo Seguro."
          }
        }
      }
    },
    "This drive isn't in Finder, so nothing syncs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta unidad no está en el Finder, así que no se sincroniza nada."
          }
        }
      }
    },
    "This drive uses plain http, which sends its password readably. Allow that first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta unidad usa http sin cifrar, que envía su contraseña de forma legible. Permítalo primero."
          }
        }
      }
    },
    "This encrypted drive was retired when its encryption password changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta unidad cifrada se retiró al cambiar su contraseña de cifrado."
          }
        }
      }
    },
    "This folder can't be read: %@" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer esta carpeta: %@"
          }
        }
      }
    },
    "This is the first time CloudAccess connects to %@. Its identity is %@. Check it matches the one your server shows, then trust it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es la primera vez que CloudAccess se conecta a %1$@. Su identidad es %2$@. Compruebe que coincide con la que muestra su servidor y confíe en él."
          }
        }
      }
    },
    "This Mac isn't connected to a network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no está conectado a ninguna red."
          }
        }
      }
    },
    "This Mac's network changed, or the Mac just woke. CloudAccess is connecting the drive again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La red de este Mac ha cambiado, o el Mac acaba de despertar. CloudAccess vuelve a conectar la unidad."
          }
        }
      }
    },
    "This server can't be used" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no se puede usar"
          }
        }
      }
    },
    "This server's identity has changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La identidad de este servidor ha cambiado."
          }
        }
      }
    },
    "This server's Tailscale address changed to %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección de Tailscale de este servidor ha cambiado a %@."
          }
        }
      }
    },
    "Those details aren't valid" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esos datos no son válidos"
          }
        }
      }
    },
    "Those details aren't valid, so nothing has been saved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esos datos no son válidos, así que no se ha guardado nada."
          }
        }
      }
    },
    "Thumbnails" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miniaturas"
          }
        }
      }
    },
    "To add a drive, choose the QR icon beside it, and scan the code in CloudWanderer." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para añadir una unidad, elija el icono QR que hay junto a ella y escanee el código en CloudWanderer."
          }
        }
      }
    },
    "Top folder" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta superior"
          }
        }
      }
    },
    "Tried %lld times, last at %@. macOS tries again by itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$#@tries@, last at %2$@. macOS tries again by itself."
          },
          "substitutions" : {
            "tries" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Tried once"
                    }
                  },
                  "other" : {
